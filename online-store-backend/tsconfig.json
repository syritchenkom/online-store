{
    "compilerOptions": {
      "target": "ES2021",
      "module": "CommonJS",
      "rootDir": "./src",
      "outDir": "./dist",
      "strict": true,
      "esModuleInterop": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "forceConsistentCasingInFileNames": true,
      "moduleResolution": "node",
      "skipLibCheck": true,
      "typeRoots": ["./src/types", "./node_modules/@types"] 
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
  }
  